<runtime ram="200M" caps="500" binary="qmloscilloscope">

	<requires>
		<gui/>
		<report label="shape"/>
		<rom    label="mesa_gpu.lib.so"/>
		<timer/>
	</requires>

	<content>

		<!-- common for Qt GUI applications -->

		<rom label="egl.lib.so"/>
		<rom label="expat.lib.so"/>
		<rom label="freetype.lib.so"/>
		<rom label="glapi.lib.so"/>
		<rom label="jpeg.lib.so"/>
		<rom label="libQt6Core.lib.so"/>
		<rom label="libQt6Gui.lib.so"/>
		<rom label="libc.lib.so"/>
		<rom label="libm.lib.so"/>
		<rom label="libpng.lib.so"/>
		<rom label="libqgenode.lib.so"/>
		<rom label="mesa.lib.so"/>
		<rom label="libdrm.lib.so"/>
		<rom label="qt6_dejavusans.tar"/>
		<rom label="qt6_libqgenode.tar"/>
		<rom label="stdcxx.lib.so"/>
		<rom label="vfs.lib.so"/>
		<rom label="vfs_gpu.lib.so"/>
		<rom label="vfs_pipe.lib.so"/>
		<rom label="zlib.lib.so"/>

		<!-- application -->

		<rom label="qt6_component.lib.so"/>
		<rom label="libQt6Charts.lib.so"/>
		<rom label="libQt6Core.lib.so"/>
		<rom label="libQt6Gui.lib.so"/>
		<rom label="libQt6Network.lib.so"/>
		<rom label="libQt6OpenGL.lib.so"/>
		<rom label="libQt6OpenGLWidgets.lib.so"/>
		<rom label="libQt6Qml.lib.so"/>
		<rom label="libQt6QmlModels.lib.so"/>
		<rom label="libQt6Quick.lib.so"/>
		<rom label="libQt6Widgets.lib.so"/>
		<rom label="libworkerscriptplugin.lib.so"/>
		<rom label="libQt6QmlWorkerScript.lib.so"/>
		<rom label="libqtchartsqml2plugin.lib.so"/>
		<rom label="libQt6ChartsQml.lib.so"/>
		<rom label="libqquicklayoutsplugin.lib.so"/>
		<rom label="libQt6QuickLayouts.lib.so"/>

		<rom label="qmloscilloscope"/>

		<rom label="qt6_charts_qml.tar"/>
		<rom label="qt6_declarative_qml.tar"/>

	</content>

	<config>
		<vfs>
			<dir name="dev">
				<log/>
				<inline name="rtc">2018-01-01 00:01</inline>
			</dir>
			<dir name="pipe"> <pipe/> </dir>
			<tar name="qt6_charts_qml.tar"/>
			<tar name="qt6_declarative_qml.tar"/>
			<tar name="qt6_dejavusans.tar"/>
			<tar name="qt6_libqgenode.tar"/>
		</vfs>
		<libc stdout="/dev/log" stderr="/dev/log" pipe="/pipe" rtc="/dev/rtc"/>
		<env key="QT_QUICK_BACKEND" value="software"/>
		<env key="QSG_RHI_BACKEND" value="null"/>
	</config>

</runtime>
