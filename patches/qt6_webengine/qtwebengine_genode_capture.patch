--- a/src/3rdparty/chromium/media/capture/video/video_capture_system_impl.cc
+++ b/src/3rdparty/chromium/media/capture/video/video_capture_system_impl.cc
@@ -52,6 +52,7 @@ bool IsCaptureFormatEqual(const media::VideoCaptureFormat& format1,
 void ConsolidateCaptureFormats(media::VideoCaptureFormats* formats) {
   if (formats->empty())
     return;
+#if !BUILDFLAG(IS_GENODE)
   // Mark all formats as I420, since this is what the renderer side will get
   // anyhow: the actual pixel format is decided at the device level.
   // Don't do this for the Y16 or NV12 formats as they are handled separately.
@@ -60,6 +61,7 @@ void ConsolidateCaptureFormats(media::VideoCaptureFormats* formats) {
         format.pixel_format != media::PIXEL_FORMAT_NV12)
       format.pixel_format = media::PIXEL_FORMAT_I420;
   }
+#endif
   std::sort(formats->begin(), formats->end(), IsCaptureFormatSmaller);
   // Remove duplicates
   auto last =
